<div class="modal fade" id="EditContactDlg" tabindex="-1" role="dialog" aria-labelledby="copyModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="Modal_Copy_Title">Edit contact</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row" style="margin:3px">
                    <div class="col">
                        <label id="lbContactName" class="text-sm-left">Name</label>
                    </div>
                    <div class="col">
                        <input id="edContactName" class="form-control form-control-sm" placeholder="Enter name" />
                    </div>
                </div>

                <div class="row" style="margin:3px">
                    <div class="col">
                        <label>E-Mail</label>
                    </div>
                    <div class="col">
                        <input id="edContacteMail" class="form-control form-control-sm" placeholder="Enter valid E-Mail" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-primary" id="btnOk" style="min-width:90px">
                    <span id="spnCopy" class="spinner-border spinner-border-sm" hidden></span>
                    <span id="btnlbOk">Ok</span>
               </button>
                <button type="button" class="btn btn-sm btn-secondary" data-dismiss="modal" style="min-width:90px">Cancel</button>
            </div>
        </div>
    </div>
</div>

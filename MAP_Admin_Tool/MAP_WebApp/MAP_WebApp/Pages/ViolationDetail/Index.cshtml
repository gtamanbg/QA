        function RepLineFieldChange(input) {
            lcId = $(input).attr('row-id');
            $('#rtr_' + lcId).attr('data-changed', 1);
            if ($('#RAS_' + lcId).val() == '2') {
                $('#ch_' + lcId).removeAttr('disabled');
                $('#RR_' + lcId).val('');
            }
            else {
                $('#ch_' + lcId).prop("checked", false);
                $('#ch_' + lcId).attr('disabled', 'disabled');
                if (($('#RAS_' + lcId).val() == '3') && $('#RR_' + lcId).val() == "") {
                    $('#RR_' + lcId).focus();
                    return;
                }
            }
        }

        $("#btnRepOk").on('click', (function (e) {
            incorectRecord = false;
            var ReplacementDetail = [];
            $('#tblViolationReplacements tbody tr[data-changed="1"]').each(function (index, tr) {
                rowId = $(tr).attr('row-id');
                if ($('#RR_' + rowId).val() == "" && $('#RAS_' + rowId).val() == 3) {
                    bootbox.alert({ title: '<div class="row"><div class="col-1"><img src="/img/error.png" width="20" style="position:absolute; padding-top:2px"/></div><div class="col">Error</div></div>', closeButton: false, centerVertical: true, message: '<h5>Аn error occurred while saving data: Missing reason on rejected rows!</h5>'});
                    incorectRecord = true;
                    return;
                }
                ReplacementDetail.push({
                    Id: rowId,
                    Notification_id: NotificationId,
                    Checked: $('#ch_' + rowId).is(":checked"),
                    ApprovalStatus_id: $('#RAS_' + rowId).val(),
                    Reason_id: $('#RR_' + rowId).val() == ""? null : $('#RR_' + rowId).val()
                });
            })

            if (incorectRecord)
                return;

            $.ajax({
                "type": "POST",
                "url": "?handler=SaveReplacement",
                "contentType": "application/json; charset=utf-8",
                "dataType": "json",
                "data": JSON.stringify(ReplacementDetail),
                "success": function (response) {
                    if (response.code != -1) {
                        $('#EditDlg').modal('hide');
                        if (response.msg != null)
                            bootbox.alert({
                                title: 'Information',
                                closeButton: false,
                                centerVertical: true,

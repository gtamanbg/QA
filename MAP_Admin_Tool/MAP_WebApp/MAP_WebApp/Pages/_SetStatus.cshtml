<div class="modal fade" id="SetStatusDlg" tabindex="-1" role="dialog" aria-labelledby="copyModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content" style="width:100%">
            <div class="modal-header">
                <h4 class="modal-title" id="Modal_Copy_Title">Edit Reason</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row" style="margin:5px">
                    <div class="col-4">
                        Approval status
                    </div>
                    <div class="col">
                        <select id="setAS" class="form-control form-control-sm selectpicker bootstrap-select-test" onchange="ApprovalStatusChange(this);">
                            <option value="1">Pending Approval</option>
                            <option value="2">Approved</option>
                            <option value="3">On Hold</option>
                            <option value="4">Void</option>
                        </select>
                    </div>
                </div>
                
                <div class="row" style="margin:5px">
                    <div class="col-4">
                        Note
                    </div>
                    <div class="col">
                        <input id="setNote" class="form-control form-control-sm text-sm-left" style="width:100%!important;background-color:inherit !important" onfocus="this.select();" onmouseup="return false;" value="">
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-primary" id="setbtnOk" style="min-width:90px">
                    <span id="spnCopy" class="spinner-border spinner-border-sm" hidden></span>
                    <span id="btnlbOk">Ok</span>
               </button>
                <button type="button" class="btn btn-sm btn-secondary" data-dismiss="modal" style="min-width:90px">Cancel</button>
            </div>
        </div>
    </div>
</div>

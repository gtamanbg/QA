@page
@model MAP_WebApp.Pages.Admin.IndexModel
@{
    ViewBag.SecondNavBar = "_SecondNavBar";
    ViewBag.SubNavPage = "Users";
}
@Html.AntiForgeryToken()

<partial name="_EditUsersView.cshtml" />

<button class="btn btn-primary" style="min-width:90px" id="btnCreateNewUser">Create new user</button>
<br />
<br />
<table id="tbl_users" class="table table-hover table-sm" width="100%">
    <thead>
        <tr>
            <th></th>
            <th class="text-sm-left" style="padding-right:0px">Name</th>
            <th class="text-sm-left" style="padding-right:0px">Okta Id</th>
            <th class="text-sm-left" style="padding-right:0px">E-Mail</th>
            <th class="text-sm-left" style="padding-right:0px">User Group</th>
            <th class="text-sm-left" style="padding-right:0px">Blocked</th>
            <th class="text-sm-left" style="padding-right:0px">Last Active</th>
        </tr>
    </thead>
</table>


@section Scripts {
    <link rel="stylesheet" href="~/css/Select.css">
    <script src="~/js/bootstrap-select.min.js"></script>

    <link href="~/lib/datatables/css/dataTables.bootstrap4.min.css" rel="stylesheet" />
    <script src="~/lib/datatables/js/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables/js/dataTables.bootstrap4.min.js"></script>

    <script>
        var selectedUser = "";
        $('#tbl_users').on('click', 'tbody tr', function () {
            selectedUser = $(this).attr('href-data');
            $('#EditDlg').modal();
        });

        $('#btnCreateNewUser').click(function (e) {
            selectedUser = "";
            $('#EditDlg').modal();
        })

        $("#btnDeleteUser").click(function (e) {
            e.preventDefault();
            $.ajax({
                url: '?handler=Delete&' + 'Id=' + selectedUser,
                type: 'POST',
                success: function (data) {
                    if (data.code == -1)
                        logError(-1, data.msg)
                    else {
                        logError(1, 'User deleted successfully!');
                        $('#EditDlg').modal('hide');
                        selectedUser = null;
                        $("#tbl_users").DataTable().ajax.reload();
                    }
                },
                headers: {
                    "RequestVerificationToken": $('input:hidden[name="__RequestVerificationToken"]').val()
                },
                cache: false,
                contentType: false,
                processData: false
            });
        })

        $("#btnSaveUser").click(function (e) {
            e.preventDefault();
            logError(0, '');
            var form = document.forms["edit_frm"];
            if (!form.checkValidity())
                return;
            var formData = new FormData(form);
            formData.append('EditUser_Id', selectedUser)

            $.ajax({
                url: '?handler=Save',
                type: 'POST',
                data: formData,
                success: function (data) {
                    if (data.code == -1)
                        logError(-1, data.msg)
                    else {
                        logError(1, 'Saved successfully!');
                        $('#EditDlg').modal('hide');
                        selectedUser = null;
                        $("#tbl_users").DataTable().ajax.reload();
                    }
                },
                headers: {
                    "RequestVerificationToken": $('input:hidden[name="__RequestVerificationToken"]').val()
                },
                cache: false,
                contentType: false,
                processData: false
            });
        })

        $('#EditDlg').on('show.bs.modal', function () {
            logError(0, '');

            if (selectedUser != "") {
                $('#btnDeleteUser').show();

                $.ajax({
                    async: false,
                    url: '?handler=Details&' + 'Id=' + selectedUser,
                    type: 'GET',
                    success: function (data) {
                        if (data.code == -1)
                            logError(-1, data.msg)
                        else {
                            document.getElementById("edFirstName").value = data.msg.firstName;
                            document.getElementById("edLastName").value = data.msg.lastName;
                            document.getElementById("edeMail").value = data.msg.eMail;
                            document.getElementById("edUserGroup").value = data.msg.userGroup_Id;
                            document.getElementById("edBlocked").checked = data.msg.blocked;
                            $('.selectpicker').selectpicker('refresh')
                        }
                    },
                    headers: {
                        "RequestVerificationToken": $('input:hidden[name="__RequestVerificationToken"]').val()
                    },
                    cache: false,
                    contentType: false,
                    processData: false
                });
            }
            else {
                document.getElementById("edFirstName").value = "";
                document.getElementById("edLastName").value = "";
                document.getElementById("edeMail").value = "";
                document.getElementById("edUserGroup").value = 0;
                document.getElementById("edBlocked").checked = false;
                $('.selectpicker').selectpicker('refresh');
                $('#edit_frm')[0].reset();
                $('#btnDeleteUser').hide();
            };
        });

        $(document).ready(function () {
            table = $("#tbl_users").DataTable({
                "serverSide": true,
                "filter": true,
                "ordering": false,
                "orderMulti": false,
                "bLengthChange": true,
                "pageLength": 25,
                "language": {
                    "emptyTable": "There ware no users found.",
                    "lengthMenu": "Show _MENU_ rows per page",
                    "info": "Showing _START_-_END_ of _TOTAL_ rows",
                    "infoEmpty": ""
                },
                "sPaginationType": "full",
                "oLanguage": {
                    "sInfo ": "Showing _START_-_END_ of _TOTAL_ rows",
                    "oPaginate": {
                        "sNext": '>',
                        "sLast": '>>',
                        "sFirst": '<<',
                        "sPrevious": '<'
                    }
                },
                "ajax": {
                    "url": "?handler=LoadTable",
                    "type": "POST",
                    "datatype": "json",
                    headers: {
                        "RequestVerificationToken": $('input:hidden[name="__RequestVerificationToken"]').val()
                    },
                },
                "columns": [
                    { "data": "id" },
                    { "data": "name" },
                    { "data": "okta_Id" },
                    { "data": "eMail" },
                    { "data": "userGroup" },
                    { "data": "blocked" },
                    { "data": "lastActive" }
                ],
                "fnRowCallback": function (nRow, aData, iDisplayIndex, iDisplayIndexFull) {
                    var id = aData.id;
                    $(nRow).attr("href-data", id);
                    $(nRow).attr("style", "cursor:pointer");
                    return nRow;
                },
                columnDefs: [
                    { "targets": 0, "className": 'text-sm-left', "visible": false },
                    { "targets": 1, "className": 'text-sm-left', "width": "15%" },
                    { "targets": 2, "className": 'text-sm-left', "width": "180px" },
                    { "targets": 3, "className": 'text-sm-left' },
                    { "targets": 4, "className": 'text-sm-left', "width": "120px" },
                    { "targets": 5, "className": 'text-sm-left', "width": "70px" },
                    { "targets": 6, "className": 'text-sm-left', "width": "150px" }
                ],
            });
        });

        function logError(lv, msg) {
            if (lv == -1) {
                $('#error_span').removeAttr('hidden');
                $('#success_span')[0].setAttribute('hidden', true);
                $('#error_span')[0].innerHTML = $('#error_span')[0].innerHTML + msg + ' <br />';
            }
            else if (lv == 1) {
                $('#error_span')[0].setAttribute('hidden', true);
                $('#success_span').removeAttr('hidden');
                $('#success_span')[0].innerHTML = msg;
            }
            else {
                $('#error_span')[0].innerHTML = '';
                $('#success_span')[0].innerHTML = '';
                $('#success_span')[0].setAttribute('hidden', true);
                $('#error_span')[0].setAttribute('hidden', true);
            }

        }
    </script>
}
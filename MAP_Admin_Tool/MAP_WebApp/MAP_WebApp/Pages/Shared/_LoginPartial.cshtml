@using MAP_WebApp.Models;
@using Microsoft.Extensions.Options;
@using Microsoft.Extensions.DependencyInjection;
@{
    string UserName = "";
    if (User.Identity.IsAuthenticated)
    {
        var openIdFields = Context.RequestServices.GetService<IOptions<OpenIdFields>>().Value;
        UserName = User.FindFirst(openIdFields.FullNameField).Value;
    }
}

<ul class="navbar-nav flex-row-reverse flex-grow-1">
    @if (User.Identity.IsAuthenticated)
    {
        <li class="nav-item">
            <div class="dropdown">
                <button class="btn btn-default dropdown-toggle" type="button" id="menu1" data-toggle="dropdown">
                    <img src="~/img/config.png" style="height:20px" />
                    <span class="caret"></span>
                </button>
                <ul class="dropdown-menu" role="menu" aria-labelledby="menu1">
                    <li class="@(ViewBag.Current == "MyAccount" ? "nav-item active" : "nav-item") " style="margin-left: 20px">
                        <a class="nav-link text-dark" asp-area="" asp-page="/User/Index">
                            <img src="~/img/profile.png" style="height:20px" />&nbsp;&nbsp;Account
                        </a>
                    </li>
                    <li class="@(ViewBag.Current == "Support" ? "nav-item active" : "nav-item") " style="margin-left: 20px">
                        <a class="nav-link text-dark" asp-area="" asp-page="/Support">
                            <img src="~/img/call.png" style="height:20px" />&nbsp;&nbsp;Support
                        </a>
                    </li>
                    @if(ViewData["UserGroup_Id"] != null && new int[] { 1}.Contains((int)ViewData["UserGroup_Id"]))
                    {
                    <li class="@(ViewBag.Current == "Admin" ? "nav-item active" : "nav-item") " style="margin-left: 20px">
                        <a class="nav-link text-dark" asp-area="" asp-page="/Admin/Index">
                            <img src="~/img/tool.png" style="height:20px" />&nbsp;&nbsp;Admin
                        </a>
                    </li>
                    }
                </ul>
            </div>
        </li>
        <li class="nav-item" style="margin-left: 20px">
            <form class="hide" id="SignOut_Form" asp-page="/User/SignOut" asp-route-returnUrl="@Url.Page("/User/SignOut/", new { area = "" })" method="post">
                <input id="redirectUrl" type="hidden" name="url" value="/" />
                <a class="nav-link text-dark" href="javascript:{}" onclick="document.getElementById('SignOut_Form').submit(); return false;">
                    <img src="~/img/logout.png" style="height:25px" />Log Out
                </a>
            </form>
        </li>
        <li class="@(ViewBag.Current == "MyAccount" ? "nav-item active" : "nav-item") " style="margin-left: 20px">
            <form class="hide" id="SignOut_Form" asp-page="/User/SignOut" asp-route-returnUrl="@Url.Page("/User/SignOut/", new { area = "" })" method="post">
                <a class="nav-link text-dark" asp-area="" asp-page="/User/Index" title="Manage">Hello @UserName.Split(" ").First()</a>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Login">Login</a>
        </li>
    }
</ul>